# Replace these examples with your domain and published, immutable image digests.
SITE_ADDRESS=play.example.com
FRONTEND_IMAGE=ghcr.io/your-account/funtime-frontend@sha256:replace-me
GATEWAY_IMAGE=ghcr.io/your-account/funtime-gateway@sha256:replace-me
CATALOG_IMAGE=ghcr.io/your-account/funtime-catalog@sha256:replace-me
ROOM_IMAGE=ghcr.io/your-account/funtime-room@sha256:replace-me
WORLD_DOMINATION_IMAGE=ghcr.io/your-account/funtime-world-domination@sha256:replace-me
# Use independent random hex passwords (URL-safe).
ROOM_DB_PASSWORD=replace-with-random-hex
WORLD_DB_PASSWORD=replace-with-another-random-hex
